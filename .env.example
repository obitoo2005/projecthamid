# Server-side Gemini API configuration (Configure in Vercel Project Settings -> Environment Variables)
# NEVER prefix GEMINI_API_KEY with VITE_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backend-managed External & Social Media Links
INSTAGRAM_URL=
WHATSAPP_URL=
DISCORD_URL=
TELEGRAM_URL=

# Partner Esports Community URLs
BLITZ_SCRIMS_URL=
NICE_ESPORTS_URL=
LEADER_ESPORTS_URL=
ESPORTS_56_URL=

# Optional webhook URL to forward scrim & creator form submissions (e.g., Discord/Slack webhook)
SUBMISSIONS_WEBHOOK_URL=
